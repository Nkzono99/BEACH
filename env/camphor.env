# shellcheck shell=bash
# camphor host optimized profile (Intel MPI + OpenMP hybrid build)

: "${USE_MODULES:=1}"
: "${MODULES_TO_UNLOAD:=PrgEnvIntel intel-python}"
: "${MODULES_TO_LOAD:=PrgEnvIntel intel/2023.2 intelmpi/2023.2}"

: "${FC:=mpiifx}"

# ifx 2023.2.4 with -xHost (AVX-512 on the Xeon Max nodes) stores xmm16 with an aligned vmovaps into a
# stack temporary that is only 8-byte aligned, so every run stops at the start of the batch loop with
# "forrtl: severe (154): array index out of bounds". AVX2 code generation avoids it. The same
# misaligned store is still emitted by ifx 2024.0 and 2025.0.4 (intel/2024.0, intel/2025.0 modules,
# measured 2026-10-22), so keep -xCORE-AVX2 with those too; the hot kernels gain nothing from AVX-512.
CAM_OPT="-O3 -no-prec-div -xCORE-AVX2 -fp-model precise"
CAM_OPT+=" -inline-level=2 -traceback -mcmodel=medium"

: "${FFLAGS:=${CAM_OPT} -qopenmp -fpp -DUSE_MPI}"
: "${LDFLAGS:=}"

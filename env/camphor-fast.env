# shellcheck shell=bash
# camphor profile with Intel's fast=1 floating-point model (opt-in).
#
# fast=1 lets ifx call the 4-lane SVML log/atan2 in the near-field kernel and apply value-unsafe
# optimizations (reassociation, reciprocal approximations, flush-to-zero) everywhere. In a 20-batch
# regolith measurement (4 MPI ranks x 16 threads), this was about 1.3x faster than camphor.env.
# Short single-thread comparisons showed charge/history differences around 1e-13; individual
# particle outcomes can change. These measurements do not bound errors for other inputs or long runs.
# Runs built with this profile are not bit-reproducible against precise builds, so keep camphor.env
# for tests and golden comparisons.
#
# fpm's release profile would append "-O3 -fp-model precise" after FFLAGS and override fast=1, so
# the profile's remaining flags are spelled out here and FPM_NO_PROFILE=1 keeps fpm from adding them.

: "${USE_MODULES:=1}"
: "${MODULES_TO_UNLOAD:=PrgEnvIntel intel-python}"
: "${MODULES_TO_LOAD:=PrgEnvIntel intel/2023.2 intelmpi/2023.2}"

: "${FC:=mpiifx}"

CAM_FAST_OPT="-O3 -xCORE-AVX2 -fp-model fast=1"
CAM_FAST_OPT+=" -pc64 -align all -error-limit 1 -reentrancy threaded -nogen-interfaces -assume byterecl"
CAM_FAST_OPT+=" -inline-level=2 -traceback"

: "${FFLAGS:=${CAM_FAST_OPT} -qopenmp -fpp -DUSE_MPI}"
: "${LDFLAGS:=}"
: "${FPM_NO_PROFILE:=1}"
